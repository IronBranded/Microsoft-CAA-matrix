{
  "name": "microsoft-cloud-attack-matrix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A DFIR reference catalog of Microsoft 365, Entra ID, and Azure Infrastructure attack & abuse scenarios — forensic artifacts, MITRE ATT&CK / ATRM mappings, Sentinel + Defender Advanced Hunting KQL, and IR runbooks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "validate:threats": "tsx scripts/validate-threats.ts",
    "new:threat": "tsx scripts/new-threat.ts",
    "predeploy": "npm run validate:threats && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
